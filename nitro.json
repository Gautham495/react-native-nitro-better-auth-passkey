{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrobetterauthpasskey"],
  "ios": {
    "iosModuleName": "NitroBetterAuthPasskey"
  },
  "android": {
    "androidNamespace": ["nitrobetterauthpasskey"],
    "androidCxxLibName": "nitrobetterauthpasskey"
  },
  "autolinking": {
    "Passkey": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPasskey"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPasskey"
      }
    }
  },
  "ignorePaths": ["node_modules", "lib"]
}
